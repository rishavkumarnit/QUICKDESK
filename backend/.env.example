APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://quickdesk:replace-with-local-password@localhost:5432/quickdesk
# For Neon, use its PostgreSQL connection URL with sslmode=require.
# Standard postgresql:// URLs are automatically mapped to the psycopg driver.
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
MONGODB_URI=
MONGODB_DATABASE=quickdesk
MONGODB_COLLECTION=knowledge_chunks
MONGODB_VECTOR_INDEX=knowledge_vector_index
# Use the same OpenAI API key in both key fields.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
