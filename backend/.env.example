APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# For Neon, use its PostgreSQL connection URL with sslmode=require.
# Standard postgresql:// URLs are automatically mapped to the psycopg driver.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/postgres
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Shared initial password for seeded demonstration accounts, at least 12 characters.
# Set this value before running: .venv/Scripts/python.exe -m app.seed
SEED_PASSWORD=
# Use the same OpenAI API key in both key fields LLM_API_KEY and EMBEDDING_API_KEY.
# Only OpenAI is currently supported for chat and embeddings.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
RAG_MIN_SCORE=0.35
